# =============================================================================
# OpenCited - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Variables marked "(optional)" have sensible defaults and can be left unset.
# =============================================================================

# ---------------------------------------------------------------------------
# Authentication (Clerk)
# ---------------------------------------------------------------------------
# Required. Get from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ---------------------------------------------------------------------------
# Database (Neon Postgres)
# ---------------------------------------------------------------------------
# Required. Neon serverless connection string with pooler.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Queue (Redis / Valkey)
# ---------------------------------------------------------------------------
# Required. Redis connection string for BullMQ job queue.
# With docker compose redis, include the password (see REDIS_PASSWORD below):
REDIS_URL=redis://:changeme@localhost:6379

# ---------------------------------------------------------------------------
# LLM Provider (AI analysis)
# ---------------------------------------------------------------------------
# Required. Model identifier for the LLM (Groq: openai/gpt-oss-20b; OpenAI: gpt-4o-mini).
LLM_MODEL=

# Optional. Provider to use: "groq", "openai", or "openai-compatible". Default: openai.
LLM_PROVIDER=openai

# Optional. Fallback API key used when no provider-specific key is set.
LLM_API_KEY=

# Optional. Groq API key (takes precedence over LLM_API_KEY when provider is "groq").
GROQ_API_KEY=

# Optional. OpenAI API key (takes precedence over LLM_API_KEY when provider is "openai").
OPENAI_API_KEY=

# Optional. Base URL for openai-compatible providers (required when LLM_PROVIDER=openai-compatible).
LLM_BASE_URL=

# ---------------------------------------------------------------------------
# Worker (BullMQ background processor)
# ---------------------------------------------------------------------------
# Optional. Number of concurrent jobs the worker processes. Default: 5.
WORKER_CONCURRENCY=5

# Optional. Port for the BullMQ admin dashboard. Default: 3001.
WORKER_PORT=3001


# ---------------------------------------------------------------------------
# Redis Password (for external access)
# ---------------------------------------------------------------------------
# Required if exposing Redis to the internet. Set a strong password.
# The worker uses this automatically, and your web app's REDIS_URL must include it.
REDIS_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Browser Crawler (Camoufox)
# ---------------------------------------------------------------------------
# Optional. Log level: "silent", "info", or "debug". Default: info.
LOGGER_LEVEL=info

# Optional. Run browser in headless mode: "true", "false", or "virtual". Default: true.
HEADLESS=true

# Camoufox binary must match the catalog camoufox-js version. If the mention-probe worker
# finishes in ~1s with "unavailable", run from repo root: bun run setup:browser-crawler
#
# Local Perplexity smoke test: bun run test:perplexity (optional PERPLEXITY_TEST_QUERY)
# PERPLEXITY_TEST_QUERY=
# PERPLEXITY_TEST_MAX_PROXIES=1
# PERPLEXITY_TEST_SKIP_PROXY=true

# ---------------------------------------------------------------------------
# Proxy Configuration (for web crawling)
# ---------------------------------------------------------------------------
# Optional. ThorData extract API (used for mention-probe / public scan when configured).
THORDATA_PROXY_API_URL=
# With IP whitelist (no PROXY_USERNAME), crawls use the country-entry gateway below—not the API IP list.
# THORDATA_PROXY_GATEWAY=http://pr.thordata.net:9999
# Set true only when using username/password with the get-ip host list:
# THORDATA_PROXY_USE_API_LIST=true
PROXY_USERNAME=
PROXY_PASSWORD=

# Optional. Overrides ThorData gateway when set (same as THORDATA_PROXY_GATEWAY for whitelist).
PROXY_SERVER=

# Optional. Enable sticky proxy (reuse last successful proxy). Default: true.
STICKY_PROXY_ENABLED=true

# Optional. Per-provider request rate caps (JSON). Keys are provider names, values have "rps" (requests per second).
# Example: CRAWL_RATE_LIMITS={"perplexity":{"rps":0.5},"chatgpt":{"rps":0.2}}
CRAWL_RATE_LIMITS={}

# ---------------------------------------------------------------------------
# Public scanner (email verification)
# ---------------------------------------------------------------------------
# Required. Resend API key for verification and report emails.
RESEND_API_KEY=

# Required. Sender in Resend. onboarding@resend.dev only delivers to your Resend
# account email; for any recipient, verify a domain and use e.g. reports@yourdomain.com.
SCAN_FROM_EMAIL=onboarding@resend.dev

# Required. Secret for hashing 6-digit verification codes (min 16 characters).
SCAN_CODE_SECRET=

# Optional. Canonical site URL for public scan share links in email (e.g. https://opencited.com).
# On Vercel, https://${VERCEL_URL} is used when this is unset.
PUBLIC_APP_URL=

# ---------------------------------------------------------------------------
# Vercel Deployment
# ---------------------------------------------------------------------------
# Optional. Automatically set by Vercel. Do not set locally.
VERCEL_URL=

# ---------------------------------------------------------------------------
# Workflow SDK (Vercel)
# ---------------------------------------------------------------------------
# Optional. Workflow target environment. Default: local.
WORKFLOW_TARGET_WORLD=local

# Optional. Absolute path to the project root for workflow execution.
WORKFLOW_PROJECT_ROOT=
