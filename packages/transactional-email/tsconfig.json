{
	"extends": "@opencited/typescript-config/react-library.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": ".",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"noEmit": true,
		"types": ["node", "bun-types"]
	},
	"include": ["emails/**/*", "src/**/*", "test/**/*"],
	"exclude": ["node_modules", "dist"]
}
