{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "@opencited/typescript-config/base.json",
	"compilerOptions": {
		"moduleResolution": "bundler",
		"module": "ESNext",
		"noEmit": true,
		"rootDir": ".",
		"types": ["node"],
		"skipLibCheck": true,
		"noImplicitAny": false
	},
	"include": ["trigger/**/*.ts", "trigger.config.ts", "src/**/*.ts"],
	"exclude": ["node_modules"]
}
