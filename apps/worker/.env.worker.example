# =============================================================================
# OpenCited Worker - Environment Variables
# =============================================================================
# Copy this file to .env.local in the project root and fill in the values.
# The deployment script reads .env.local from the project root.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (Neon Postgres)
# ---------------------------------------------------------------------------
# Required. Neon serverless connection string with pooler.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Redis Password (for external access)
# ---------------------------------------------------------------------------
# Required if exposing Redis to the internet. Set a strong password.
# The worker uses this automatically, and your web app's REDIS_URL must include it.
REDIS_PASSWORD=changeme

# ---------------------------------------------------------------------------
# LLM Provider (AI brand intelligence extraction)
# ---------------------------------------------------------------------------
# Required. Model identifier (e.g., gpt-4o-mini, qwen/qwen3-32b).
LLM_MODEL=gpt-4o-mini

# Required. Provider: "openai", "groq", or "openai-compatible".
LLM_PROVIDER=openai

# Required. API key for your chosen provider.
# OPENAI_API_KEY takes precedence when LLM_PROVIDER=openai
# GROQ_API_KEY takes precedence when LLM_PROVIDER=groq
# LLM_API_KEY is the fallback
OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# LLM_API_KEY=

# For openai-compatible providers only:
# LLM_BASE_URL=https://api.example.com/v1

# ---------------------------------------------------------------------------
# Proxy Configuration (optional, for web crawling)
# ---------------------------------------------------------------------------
# Single proxy fallback (used when THORDATA_PROXY_API_URL is not set).
# PROXY_SERVER=http://proxy.example.com:8080
# PROXY_USERNAME=user
# PROXY_PASSWORD=pass

# ---------------------------------------------------------------------------
# Worker Tuning (optional)
# ---------------------------------------------------------------------------
# Number of concurrent jobs. Each job uses ~200-500MB RAM.
# WORKER_CONCURRENCY=5

# ---------------------------------------------------------------------------
# Logging (optional)
# ---------------------------------------------------------------------------
# Log level: "silent", "info", or "debug"
# LOGGER_LEVEL=info
