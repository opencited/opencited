# Redis/Valkey connection (required)
REDIS_URL=redis://localhost:6379

# Neon Postgres connection (required)
DATABASE_URL=

# LLM provider for brand intelligence extraction (required)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Worker concurrency (optional, default: 5)
WORKER_CONCURRENCY=5

# Port for worker dashboard (optional, default: 3001)
PORT=3001

# Log level (optional, default: info). Values: debug, info, warn, error, off
LOGGER_LEVEL=info

# Axiom cloud logging (optional)
AXIOM_TOKEN=
AXIOM_DATASET=
AXIOM_TRANSPORT_ENABLED=false

# Show Camoufox browser UI (optional, default: true). Values: "true", "false", or "virtual"
HEADLESS=true

# ThorData residential proxy API (optional)
# When set, crawl jobs will rotate through proxies from this API
# If all proxies fail, the job will fail (never crawls without proxy)
THORDATA_PROXY_API_URL=

# Single proxy fallback (used only when THORDATA_PROXY_API_URL is not set)
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# Sticky proxy: reuse the last successful proxy for subsequent crawls (optional, default: true)
STICKY_PROXY_ENABLED=true

# Daily crawl health check (optional)
# Runs the same browser crawl path as production against a fixed neutral query,
# stops after the raw CrawlResult, and emits `crawl_health_check` events to Axiom.
# Cron is second-precision (BullMQ): second minute hour day month weekday.
CRAWL_HEALTH_CHECK_CRON="0 0 6 * * *"
CRAWL_HEALTH_CHECK_TZ=Asia/Kolkata
CRAWL_HEALTH_CHECK_QUERY="What is the best CRM for small business?"
