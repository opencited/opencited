# Redis/Valkey connection (required)
REDIS_URL=redis://localhost:6379

# Neon Postgres connection (required)
DATABASE_URL=

# LLM provider for brand intelligence extraction (required)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Worker concurrency (optional, default: 5)
WORKER_CONCURRENCY=5

# Port for worker dashboard (optional, default: 3001)
PORT=3001

# Log level for browser crawler (optional, default: info)
LOGGER_LEVEL=info

# Show Camoufox browser UI (optional, default: true)
HEADLESS=true
