{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "stream",
	"globalDependencies": [
		".env*"
	],
	"globalEnv": [
		"NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
		"CLERK_SECRET_KEY",
		"DATABASE_URL",
		"REDIS_URL",
		"OPENAI_API_KEY",
		"LLM_PROVIDER",
		"LLM_BASE_URL",
		"LLM_API_KEY",
		"LLM_MODEL",
		"GROQ_API_KEY",
		"WORKER_CONCURRENCY",
		"WORKER_PORT",
		"THORDATA_PROXY_API_URL",
		"STICKY_PROXY_ENABLED",
		"HEADLESS",
		"DEBUG_PAUSE_ON_FAILURE",
		"AXIOM_TOKEN",
		"AXIOM_DATASET",
		"AXIOM_TRANSPORT_ENABLED"
	],
	"tasks": {
		"build": {
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*"
			],
			"outputs": [
				".next/**",
				"!.next/cache/**",
				"app/.well-known/workflow/**"
			]
		},
		"lint": {
			"dependsOn": [
				"^lint"
			]
		},
		"tsc": {
			"dependsOn": [
				"^tsc"
			]
		},
		"migrate": {
			"dependsOn": [
				"^migrate"
			],
			"cache": false
		},
		"generate": {
			"dependsOn": [
				"^generate"
			]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"dev:turbo": {
			"cache": false,
			"persistent": true
		},
		"start": {
			"cache": false,
			"persistent": true
		}
	}
}